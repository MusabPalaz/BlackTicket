# Build context is the repository root:
#   docker build -f docker/Dockerfile.web .

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/web/package.json packages/web/
RUN npm ci

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/web packages/web

# No VITE_API_URL is set, deliberately. Unset, the client falls back to the
# relative path /api/v1, which is correct behind the reverse proxy: the browser
# talks to one origin and CORS never enters the picture. Baking an absolute URL
# in here would tie the image to one customer's hostname.
RUN npm run build -w @black-ticket/shared \
 && npm run build -w @black-ticket/web

# ------------------------------------------------------------------- runtime
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/packages/web/dist /usr/share/nginx/html
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
