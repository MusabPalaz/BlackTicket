# Black Ticket deployment settings. Copy to .env beside compose.yml.
#
# ---------------------------------------------------------------------------
# THE ENCRYPTION KEY IS NOT RECOVERABLE.
#
# TOTP_ENCRYPTION_KEY decrypts every user's two-factor seed, the single sign-on
# client secret and the outbound mail password. Those live encrypted in the
# database; the key does not. A database backup without this key restores a
# system where two-factor is broken for everyone, SSO cannot authenticate and
# mail cannot send, with no way to recover any of it.
#
# Generate the three secrets once, store them wherever the organisation keeps
# secrets, and never rotate them casually.
#
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# The internal DNS name this is reached by. Must match the certificate in
# ./certs and, if single sign-on is used, the redirect URI registered with the
# identity provider. Getting this wrong breaks SSO and the links in e-mails.
PUBLIC_HOST=ticketing.example.local

# Where the release images actually live. There is no default: a placeholder
# that looks like a real address fails at pull time with a bare "denied", which
# reads like a permissions problem rather than a wrong address. package.ps1
# writes these for the customer bundle -- a registry path for an online install,
# or the plain local names for an offline one, matching the tars in images/.
IMAGE_API=
IMAGE_WEB=
# Pin a version rather than leaving `latest`: an update should be a decision.
TAG=latest

POSTGRES_USER=blackticket
POSTGRES_DB=blackticket
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOTP_ENCRYPTION_KEY=

# Sized against concurrent requests, not users. A load test at 800 accounts and
# ~40 concurrent analysts sat comfortably at 50.
DATABASE_POOL_MAX=50

# Per IP, per minute.
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_INGEST_PER_MIN=100
RATE_LIMIT_SCIM_PER_MIN=600

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
