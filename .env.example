# ---------------------------------------------------------------------------
# Black Ticket — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
API_PORT=3000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://blackticket:CHANGE_ME@localhost:5432/blackticket?schema=public

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_BYTES
JWT_ACCESS_TTL=15m
# Encrypts TOTP seeds at rest. Rotating it invalidates every enrolled authenticator.
TOTP_ENCRYPTION_KEY=CHANGE_ME_MIN_32_BYTES_TOTP
JWT_REFRESH_TTL=7d

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_INGEST_PER_MIN=100

# --- Correlation ------------------------------------------------------------
# An observable seen in more cases than this is treated as a noisy indicator
# and no longer produces automatic case links.
CORRELATION_FANOUT_LIMIT=50

# --- Bootstrap admin (used by `npm run db:seed`, first run only) -------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@blackticket.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# Break-glass administrator. Cannot be deleted, disabled or demoted from any
# screen, so there is always a way back in. Keep this password wherever the
# organisation keeps its emergency credentials, not in day-to-day storage.
SEED_RECOVERY_USERNAME=recovery
SEED_RECOVERY_EMAIL=recovery@blackticket.local
SEED_RECOVERY_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# --- Web (Vite) -------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
